model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode","MCP-PBIModeling"]

annotation PBI_QueryOrder = ["PastaDados","fato_comercio","dim_data","dim_ncm","dim_pais","dim_porto","dim_uf"]

ref table _Medidas
ref table fato_comercio
ref table dim_data
ref table dim_ncm
ref table dim_pais
ref table dim_porto
ref table dim_uf

ref cultureInfo pt-BR

